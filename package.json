{
  "name": "portfolio-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Editor de portfólio v4 — reescrita do núcleo (schema, migração, renderer, editor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "e2e": "playwright test",
    "publish": "node scripts/publish.mjs",
    "build:editor": "vite build --config vite.editor.config.ts",
    "gen:shell": "node scripts/gen-shell.mjs",
    "prebuild:editor": "npm run gen:shell && npm run gen:preview",
    "gen:preview": "node scripts/gen-preview-css.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
